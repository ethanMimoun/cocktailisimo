rules_version = '2';

// Firestore Security Rules for Cocktailisimo
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Strategy:
// - Public can CREATE orders (place orders from the storefront), but cannot
//   read, list, update, or delete them. This prevents leaking customer data.
// - Only authenticated admins can read/list/update/delete orders.
// - Server timestamp + required fields are enforced on create to prevent
//   malformed or spammy writes.

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Orders collection =====
    match /orders/{orderId} {

      // Only signed-in admins can read individual orders or list them
      allow read: if request.auth != null;

      // Anyone can place an order, but the document MUST conform to a strict shape
      allow create: if isValidNewOrder(request.resource.data);

      // Only signed-in admins can update or delete orders
      allow update, delete: if request.auth != null;
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ===== Validation helpers =====

function isValidNewOrder(data) {
  return
    // Required top-level fields
    data.keys().hasAll(['orderNumber','status','customer','address','delivery','items','payment','subtotal','total','itemsCount','createdAt'])
    // Server-generated timestamp (prevents client clock manipulation)
    && data.createdAt == request.time
    // Status must always start as "new"
    && data.status == 'new'
    // Order number format
    && data.orderNumber is string
    && data.orderNumber.size() >= 4
    && data.orderNumber.size() <= 32
    // Customer info
    && data.customer.keys().hasAll(['name','phone'])
    && data.customer.name is string && data.customer.name.size() >= 2 && data.customer.name.size() <= 120
    && data.customer.phone is string && data.customer.phone.size() >= 9 && data.customer.phone.size() <= 20
    // Address info
    && data.address.keys().hasAll(['city','street'])
    && data.address.city is string && data.address.city.size() >= 2 && data.address.city.size() <= 80
    && data.address.street is string && data.address.street.size() >= 3 && data.address.street.size() <= 200
    // Delivery
    && data.delivery.keys().hasAll(['date','time'])
    && data.delivery.date is string
    && data.delivery.time is string
    // Items must be a non-empty list, capped to a reasonable size
    && data.items is list
    && data.items.size() > 0
    && data.items.size() <= 100
    // Totals must be non-negative numbers within sane bounds
    && data.subtotal is number && data.subtotal >= 0 && data.subtotal <= 100000
    && data.total is number && data.total >= 0 && data.total <= 100000
    && data.itemsCount is int && data.itemsCount > 0 && data.itemsCount <= 500
    // Payment method must be one of the allowed values
    && data.payment.method in ['card','cash'];
}
